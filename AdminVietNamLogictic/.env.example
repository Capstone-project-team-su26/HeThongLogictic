# ------------------------------------------------------------------
# Sao chép file này thành .env nếu cần. App CHẠY ĐƯỢC khi không có .env:
# mọi biến dưới đây đều tuỳ chọn, thiếu thì dùng giá trị mặc định.
#
# Mọi biến VITE_* đều bị nhúng vào bundle và người dùng cuối đọc được —
# tuyệt đối không đặt bí mật phía server vào đây.
#
# Chỉ liệt kê biến CÒN ĐƯỢC ĐỌC trong src/. Kiểm chứng:
#   grep -rn "import.meta.env" src/
# ------------------------------------------------------------------

# Gốc backend VCL. Đọc ở src/shared/api/httpClient.js — base URL của mọi lời gọi
# API thật (đăng nhập, hồ sơ, đơn ký gửi, báo giá, duyệt giá, danh mục).
# Bỏ trống -> https://api-vcl.vnlogistic.click (production). Dấu "/" cuối bị cắt.
#
# ĐỪNG trỏ sang https://api-vcl.zushin.io.vn: đó là một bản deploy khác chạy CODE CŨ,
# không có các API của đợt này (dịch vụ theo kiện, duyệt giá ngoại lệ, khu kho).
VITE_API_BASE_URL=https://api-vcl.vnlogistic.click
